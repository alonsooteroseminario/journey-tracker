        "autoprefixer": "^10.0.1",
        "eslint": "^9.39.2",
        "eslint-config-next": "^15.5.11",
        "happy-dom": "^12.10.3",
        "jsdom": "^27.4.0",
        "postcss": "^8",
        "prisma": "^6.19.2",
        "tailwindcss": "^3.4.1",
        "typescript": "^5",
        "vitest": "^1.6.1"
    },
