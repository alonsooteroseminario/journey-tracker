{
    "name": "journey-tracker",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "postinstall": "prisma generate",
        "dev": "next dev --webpack",
        "build": "prisma generate && next build --webpack",
        "start": "next start",
        "lint": "next lint",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "test:all": "vitest run && playwright test",
        "video:studio": "remotion studio src/remotion/index.ts",
        "video:render": "remotion render src/remotion/index.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.72.1",
        "@clerk/nextjs": "^6.37.1",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@prisma/client": "^6.19.2",
        "@react-email/components": "^1.0.7",
        "@reduxjs/toolkit": "^2.11.2",
        "@remotion/cli": "4.0.234",
        "@remotion/renderer": "4.0.234",
        "claude": "^0.1.1",
        "date-fns": "^4.1.0",
        "next": "^16.1.6",
        "playwright": "1.49.1",
        "react": "^18",
        "react-dom": "^18",
        "react-redux": "^9.2.0",
        "recharts": "^3.7.0",
        "remotion": "4.0.234",
        "resend": "^6.9.1",
        "server-only": "^0.0.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@playwright/test": "^1.58.1",
        "@react-email/render": "^2.0.4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "autoprefixer": "^10.0.1",
        "eslint": "^9.39.2",
        "eslint-config-next": "^15.5.11",
        "happy-dom": "^20.5.0",
        "jsdom": "^27.4.0",
        "postcss": "^8",
        "prisma": "^6.19.2",
        "tailwindcss": "^3.4.1",
        "typescript": "^5",
        "vitest": "^4.0.18"
    },
    "optionalDependencies": {
        "@next/swc-linux-x64-gnu": "15.5.11"
    }
