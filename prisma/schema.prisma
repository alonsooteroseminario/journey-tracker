generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============== User Model ==============
model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  clerkId       String   @unique
  email         String   @unique
  name          String
  profileImage  String?
  bio           String?
  location      String?
  timezone      String?
  joinedDate    DateTime @default(now())
  lastLoginDate DateTime @default(now())

  // Relations
  goals            Goal[]
  streakData       StreakData?
  friendships      Friendship[]      @relation("UserFriendships")
  friendOf         Friendship[]      @relation("FriendOfUser")
  invitations      Invitation[]
  socialShares     SocialShare[]
  activityLog      ActivityLog[]
  emailPreferences EmailPreferences?
  feedPreferences  FeedPreferences?
  feedItems        FeedItem[]        @relation("FeedItemAuthor")
  feedComments     FeedComment[]
  feedCheers       FeedCheer[]
  goalTemplates    GoalTemplate[]    @relation("TemplateAuthor")
  goalForks        GoalFork[]
  forkRequests     ForkRequest[]     @relation("ForkRequester")
  socialAccounts   SocialAccount[]
  socialPosts      SocialPost[]
  marketingCampaigns MarketingCampaign[]
  videos           Video[]
  recordings       Recording[]
  goalGroups       GoalGroup[]
  goalStreaks       GoalStreak[]  @relation("UserGoalStreaks")
  promptWallets    PromptWallet[]

  hideCompletedAfterDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ============== Goal Model ==============
model Goal {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  userId      String @db.ObjectId
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  icon        String?

  // Tasks stored as embedded JSON (preserves existing nested structure)
  tasks Json // Array of Task objects with nested substeps

  // Rich metadata stored as JSON
  phases    Json? // Array of Phase objects
  budget    Json? // BudgetSummary object
  timeline  Json? // TimelineComparison object
  documents Json? // Array of DocumentItem objects
  resources Json? // Array of ResourceCategory objects

  // Dates
  startDate  DateTime?
  targetDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Full transparency for friends
  isPublic Boolean @default(true)

  // Goal group (optional)
  groupId String?    @db.ObjectId
  group   GoalGroup? @relation(fields: [groupId], references: [id])

  // User-defined display order
  order    Int?

  @@index([userId])
  @@map("goals")
}

// ============== Goal Group Model ==============
model GoalGroup {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color String  @default("#6366f1")
  icon  String?
  order Int     @default(0)

  goals Goal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("goal_groups")
}

// ============== Prompt Wallet (reusable prompt snippets) ==============
model PromptWallet {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  userId      String        @db.ObjectId
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  icon        String?
  description String?
  order       Int           @default(0)
  lockLevel   String?

  // Sharing — null means private; present value is an unguessable capability token.
  // Not @unique because MongoDB unique indexes reject multiple null values.
  // Uniqueness is guaranteed by generateShareToken() (128-bit crypto random).
  shareToken  String?
  sharedAt    DateTime?

  groups      PromptGroup[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([shareToken])
  @@map("prompt_wallets")
}

model PromptGroup {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  walletId    String        @db.ObjectId
  wallet      PromptWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int           @default(0)
  lockLevel   String?

  chunks      PromptChunk[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([walletId])
  @@map("prompt_groups")
}

model PromptChunk {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  groupId   String       @db.ObjectId
  group     PromptGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  title     String
  content   String
  order     Int          @default(0)
  lockLevel String?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([groupId])
  @@map("prompt_chunks")
}

// ============== Streak Data Model ==============
model StreakData {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @unique @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  streakHistory    String[] // Array of ISO date strings (YYYY-MM-DD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("streaks")
}

// ============== Goal Streak Model ==============
model GoalStreak {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  goalId String @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation("UserGoalStreaks", fields: [userId], references: [id], onDelete: Cascade)

  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastCompletionDate DateTime?
  streakHistory      String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goalId, userId])
  @@map("goal_streaks")
}

// ============== Friendship Model ==============
model Friendship {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId   String @db.ObjectId
  user     User   @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)

  friendId String @db.ObjectId
  friend   User   @relation("FriendOfUser", fields: [friendId], references: [id], onDelete: Cascade)

  status    String   @default("accepted") // "pending" | "accepted" | "rejected"
  addedDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@map("friendships")
}

// ============== Invitation Model ==============
model Invitation {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  usedBy    String? // Clerk ID of the user who used it
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@map("invitations")
}

// ============== Social Share Model ==============
model SocialShare {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform      String // "twitter" | "facebook" | "linkedin" | "whatsapp"
  message       String
  streakAtTime  Int      @default(0)
  timestamp     DateTime @default(now())

  @@index([userId])
  @@map("social_shares")
}

// ============== Activity Log Model ==============
model ActivityLog {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String // "task_completed" | "goal_created" | "streak_milestone" | etc.
  action      String // Human-readable description
  goalId      String? // Reference to goal (stored as string, not relation for flexibility)
  taskId      String?
  substepId   String?
  metadata    Json? // Additional data
  timestamp   DateTime @default(now())

  @@index([userId, timestamp])
  @@map("activity_logs")
}

// ============== Email Preferences Model ==============
model EmailPreferences {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled          Boolean @default(true)
  frequency        String  @default("daily") // "immediate" | "daily" | "weekly"

  // Notification type toggles
  welcomeEmail          Boolean @default(true)
  profileChanges        Boolean @default(true)
  goalCreated           Boolean @default(true)
  goalDeleted           Boolean @default(true)
  friendInvitation      Boolean @default(true)
  goalPublished         Boolean @default(true)
  goalShared            Boolean @default(true)
  goalForked            Boolean @default(true)
  streakMilestone       Boolean @default(true)
  streakReminder        Boolean @default(true)
  friendStreakReminder  Boolean @default(true)
  friendActivity        Boolean @default(true)
  morningDigest         Boolean @default(true)
  overdueAlert          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_preferences")
}

// ============== Feed Preferences Model ==============
model FeedPreferences {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalEvents    Boolean @default(true)
  taskEvents    Boolean @default(true)
  substepEvents Boolean @default(true)
  costEvents    Boolean @default(true)
  noteEvents    Boolean @default(true)
  profileEvents Boolean @default(true)
  socialEvents  Boolean @default(true)
  streakEvents  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feed_preferences")
}

// ============== Social Feed Models ==============
model FeedItem {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation("FeedItemAuthor", fields: [userId], references: [id], onDelete: Cascade)

  type       String // "streak_milestone" | "goal_created" | "task_completed" | "goal_shared" | "goal_published" | "goal_forked"
  content    String // Human-readable description
  metadata   Json?  // Type-specific data (goalId, streakCount, templateId, etc.)
  visibility String @default("friends") // "friends" | "public"

  comments FeedComment[]
  cheers   FeedCheer[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("feed_items")
}

model FeedComment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  feedItemId String   @db.ObjectId
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  content   String
  createdAt DateTime @default(now())

  @@index([feedItemId, createdAt])
  @@map("feed_comments")
}

model FeedCheer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  feedItemId String   @db.ObjectId
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji     String   @default("🎉")
  createdAt DateTime @default(now())

  @@unique([feedItemId, userId])
  @@index([feedItemId])
  @@map("feed_cheers")
}

// ============== Goal Template & Marketplace Models ==============
model GoalTemplate {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  authorId String @db.ObjectId
  author   User   @relation("TemplateAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  originalGoalId String @db.ObjectId

  title       String
  description String?
  icon        String?

  // Snapshot of goal structure
  tasks     Json  // Array of Task objects (with substeps)
  phases    Json? // Array of Phase objects
  timeline  Json? // TimelineComparison
  resources Json? // Array of ResourceCategory objects

  // Creator notes
  lessonsLearned    String?
  tips              String?
  estimatedDuration String?
  difficulty        String? // "beginner" | "intermediate" | "advanced"

  // Sharing & marketplace
  visibility  String  @default("friends") // "friends" | "public"
  isPublished Boolean @default(false)
  category    String? // "career" | "health" | "education" | "immigration" | "finance" | "other"
  tags        String[]

  // Stats
  forkCount Int @default(0)

  forks        GoalFork[]
  forkRequests ForkRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([visibility, isPublished])
  @@map("goal_templates")
}

model GoalFork {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  templateId String       @db.ObjectId
  template   GoalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String       @db.ObjectId
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  newGoalId String // ID of the newly created goal
  forkedAt  DateTime @default(now())

  @@index([templateId])
  @@index([userId])
  @@map("goal_forks")
}

model ForkRequest {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  templateId  String       @db.ObjectId
  template    GoalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  requesterId String       @db.ObjectId
  requester   User         @relation("ForkRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  status  String  @default("pending") // "pending" | "approved" | "rejected"
  message String? // optional message from requester

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([requesterId])
  @@index([templateId, status])
  @@map("fork_requests")
}

// ============== Social Media & Marketing Models ==============
model SocialAccount {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform        String // "twitter" | "instagram"
  platformUserId  String // User ID on the platform
  username        String
  displayName     String?
  profileImage    String?

  // Encrypted OAuth tokens
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?

  // Platform-specific metadata
  metadata        Json? // followerCount, bio, etc.

  isActive        Boolean  @default(true)
  lastSyncedAt    DateTime @default(now())

  posts           SocialPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform, platformUserId])
  @@index([userId])
  @@index([platform])
  @@map("social_accounts")
}

model SocialPost {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String @db.ObjectId
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  campaignId String? @db.ObjectId
  campaign   MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Content
  content       String
  mediaUrls     String[] // URLs to images/videos
  hashtags      String[]

  // Scheduling
  status        String   @default("draft") // "draft" | "scheduled" | "posted" | "failed"
  scheduledFor  DateTime?
  postedAt      DateTime?

  // Platform post reference
  platformPostId String? // ID on the social platform after posting
  postUrl        String? // Public URL to the post

  // Analytics (populated after posting)
  analytics     Json? // likes, shares, comments, reach, etc.
  impressions   Int? // View count
  likes         Int? // Like count
  retweets      Int? // Retweet/share count
  comments      Int? // Comment count
  clicks        Int? // Link click count
  analyticsLastFetched DateTime? // Last time analytics were updated

  // A/B testing
  abTestGroup   String? // "A" | "B" | null

  // Goal linking for automated posting
  linkedGoalId  String? @db.ObjectId

  error         String? // Error message if posting failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([accountId])
  @@index([campaignId])
  @@index([scheduledFor])
  @@map("social_posts")
}

model MarketingCampaign {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?

  // Campaign configuration
  targetGoals     String[] // Array of goal IDs to promote
  platforms       String[] // ["twitter", "instagram"]
  postingSchedule Json?    // Cron-like schedule or specific times

  status          String   @default("draft") // "draft" | "active" | "paused" | "completed"

  startDate       DateTime?
  endDate         DateTime?

  posts           SocialPost[]

  // AI-generated content templates
  contentTemplates Json? // Array of content variations

  // A/B testing configuration
  abTestEnabled Boolean @default(false)
  abTestConfig  Json? // { variants: ['A', 'B'], metric: 'engagement', ... }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("marketing_campaigns")
}

model Video {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?

  // Video type and source data
  templateType String // "goal_progress" | "streak_milestone" | "task_completion"
  sourceData   Json   // Goal/streak data used for generation

  // Rendering
  status       String   @default("pending") // "pending" | "rendering" | "completed" | "failed"
  renderJobId  String?  // Job ID for tracking render progress
  duration     Int?     // Duration in seconds
  width        Int      @default(1920)
  height       Int      @default(1080)
  fps          Int      @default(30)

  // Output
  videoUrl     String?  // URL to rendered video file
  thumbnailUrl String?  // URL to video thumbnail
  fileSize     Int?     // Size in bytes

  error        String?  // Error message if rendering failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([templateType])
  @@map("videos")
}

model Recording {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?

  // Recording flow type
  flowType    String // "goal_creation" | "task_completion" | "dashboard_tour" | "custom"
  flowConfig  Json   // Configuration for the recording flow

  // Recording status
  status      String   @default("pending") // "pending" | "recording" | "completed" | "failed"

  // Output
  videoUrl    String?  // URL to recorded video file
  duration    Int?     // Duration in seconds
  fileSize    Int?     // Size in bytes

  error       String?  // Error message if recording failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([flowType])
  @@map("recordings")
}

// ============== Cost Tracker Models ==============
model CostTransaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  amount      Float
  category    String   // "anthropic" | "elevenlabs" | "cursor" | "other"
  description String?
  date        DateTime
  source      String   // "manual" | "auto-anthropic" | "sync-elevenlabs"
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, date])
  @@map("cost_transactions")
}

model Budget {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  monthlyLimit   Float    @default(100)
  categoryLimits Json?
  updatedAt      DateTime @updatedAt

  @@map("budgets")
}

model LLMCredential {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  provider     String    // "anthropic" | "elevenlabs"
  label        String    @default("Default") // user-visible, e.g. "Work", "Personal"
  keyType      String?   // "standard" | "admin" — anthropic only; null for other providers
  encryptedKey String
  iv           String
  maskedKey    String
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider, label])
  @@index([userId])
  @@map("llm_credentials")
}
